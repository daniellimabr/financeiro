# Copiar para .env e preencher — nunca commitar o .env real.

# Postgres
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=financeiro

# Backend
DATABASE_URL=postgresql+psycopg://financeiro:troque-esta-senha@postgres:5432/financeiro
JWT_SECRET_KEY=troque-por-um-segredo-aleatorio-de-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://<ip-da-vm-dev>:8080
COOKIE_SECURE=false

# Caddy — porta de preview exposta na VM de dev
DEV_PREVIEW_PORT=8080
