# Copiar para .env e preencher — nunca commitar o .env real.

# Postgres
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=financeiro

# Backend
DATABASE_URL=postgresql+psycopg://financeiro:troque-esta-senha@postgres:5432/financeiro  # pragma: allowlist secret
JWT_SECRET_KEY=troque-por-um-segredo-aleatorio-de-32-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google rejeita IP puro como redirect URI — use um domínio (ex.: DuckDNS gratuito
# apontando para o IP da VM), nunca o IP direto:
OAUTH_REDIRECT_BASE_URL=http://<dominio-da-vm-dev>:8080
COOKIE_SECURE=false

# Caddy — porta de preview exposta na VM de dev
DEV_PREVIEW_PORT=8080

# Pluggy (sandbox) — credenciais fornecidas pelo CEO, configurar manualmente
# no .env da VM de dev antes da validação ponta a ponta. Nunca commitar valores reais.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_SYNC_CUTOFF_DATE=2026-01-01
